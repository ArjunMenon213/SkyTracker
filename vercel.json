{
  "version": 2,
  "builds": [
    {
      "src": "backend/package.json",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "backend/src/index.ts"
    }
  ],
  "env": {
    "PORT": "3000",
    "OPENSKY_USERNAME": "@opensky_username",
    "OPENSKY_PASSWORD": "@opensky_password",
    "NODE_ENV": "production",
    "POLLING_INTERVAL": "10000"
  }
}
